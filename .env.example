# =============================================================================
# Frontend (Vite / TanStack Start) — copy to ".env" and adjust values.
# =============================================================================

# Lovable AI gateway (optional). If unset, AI cards show a short message instead of crashing.
# Get a key from your Lovable workspace if you use AI features.
LOVABLE_API_KEY=

# Optional alias (some setups read this name):
# VITE_LOVABLE_API_KEY=

# Backend API base URL for frontend calls (dev backend runs on 8081 in this project):
# VITE_API_BASE_URL=http://localhost:8081

# =============================================================================
# Backend (Spring Boot, dev profile) — set in the shell or your IDE run config.
# Not read from this file automatically; export / configure separately.
# =============================================================================

# PostgreSQL: create database "finance_app" and a user (often "postgres") with a known password.
# Example (psql): CREATE DATABASE finance_app;

# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=your_local_postgres_password

# Alternative name supported by application-dev.yml:
# POSTGRES_PASSWORD=your_local_postgres_password
