{
  "info": {
    "_postman_id": "8e8ca0a0-c2a4-4ad8-8c2b-1be13e8ac001",
    "name": "GlowBackend Local",
    "description": "Local JHipster backend collection for auth and core user endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": "admin"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "businessId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "POST /api/authenticate (Login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "if (body && body.id_token) {",
                  "  pm.collectionVariables.set(\"token\", body.id_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"rememberMe\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/authenticate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "authenticate"
              ]
            }
          }
        },
        {
          "name": "GET /api/authenticate (Check Auth)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/authenticate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "authenticate"
              ]
            }
          }
        }
      ]
    },
