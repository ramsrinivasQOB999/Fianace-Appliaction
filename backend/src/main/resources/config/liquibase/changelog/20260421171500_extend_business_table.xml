<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260421171500-1" author="codex">
        <addColumn tableName="business">
            <column name="owner_name" type="varchar(120)"/>
            <column name="logo_url" type="varchar(500)"/>
            <column name="pan_number" type="varchar(20)"/>
            <column name="city" type="varchar(120)"/>
            <column name="state" type="varchar(120)"/>
            <column name="billing_address_json" type="text"/>
            <column name="shipping_address_json" type="text"/>
            <column name="shipping_same_as_billing" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="fy_start_month" type="int" defaultValueNumeric="4">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
